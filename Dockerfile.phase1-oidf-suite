FROM docker.io/library/maven:3.9.11-eclipse-temurin-21@sha256:6fdc855a6ed81d288ca7ca37ac6ff5e9308b612485c0801d70b25a858c83d237 AS builder

ARG ASTER_PHASE1_OIDF_SUITE_COMMIT
WORKDIR /source
COPY .git/HEAD /tmp/aster-phase1-oidf-suite-head
COPY . /source
RUN test "${ASTER_PHASE1_OIDF_SUITE_COMMIT}" = '0dc0e3a21ec411e92c808e5b2e2258592c22b594' \
  && test "$(cat /tmp/aster-phase1-oidf-suite-head)" = "${ASTER_PHASE1_OIDF_SUITE_COMMIT}" \
  && mvn -B -Dmaven.test.skip=true -Dpmd.skip=true clean package

FROM docker.io/library/eclipse-temurin:21-jre-jammy@sha256:61d6c7b34d36aee3f45d043101259f97f3c6d428dc2a6f75513789983c5e254f

ARG ASTER_PHASE1_OIDF_SUITE_COMMIT
LABEL org.opencontainers.image.source="https://gitlab.com/openid/conformance-suite.git" \
  org.opencontainers.image.revision="${ASTER_PHASE1_OIDF_SUITE_COMMIT}" \
  com.aster.phase1.maven-resolution="source-pom-not-fully-offline-locked"

RUN groupadd --gid 10001 oidf \
  && useradd --uid 10001 --gid oidf --home-dir /nonexistent --shell /usr/sbin/nologin oidf \
  && install -d -o oidf -g oidf -m 0755 /server

COPY --from=builder --chown=10001:10001 /source/target/fapi-test-suite.jar /server/fapi-test-suite.jar

USER 10001:10001
WORKDIR /server
EXPOSE 8080
ENTRYPOINT ["/bin/sh", "-ec"]
